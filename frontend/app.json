{
  "expo": {
    "name": "Lify",
    "slug": "lify",
    "scheme": "lify",
    "version": "1.2.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/LifyIcon2.png",
    "web": {
      "favicon": "./assets/images/LifyIcon2.png"
    },
    "ios": {
      "bundleIdentifier": "com.lify.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.lify.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },  
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/LifyIcon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121212"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6f42ab35-1aec-430f-99e6-d1d6889d317e"
      }
    }
  }
}
