# URL principal do Lify. No desenvolvimento, o Android Emulator acessa o PC por este endereço.
EXPO_PUBLIC_LIFY_SERVER_URL=http://10.0.2.2:4000
# For a physical Android device on the same Wi-Fi, use the computer's LAN IP:
# EXPO_PUBLIC_LIFY_SERVER_URL=http://192.168.1.20:4000
# Depois do deploy principal, substitua pela URL HTTPS do servidor Lify.
